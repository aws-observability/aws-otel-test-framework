{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "structured log schema",
  "description": "json schema for the cloudwatch agent k8s structured log",
  "type": "object",

  "properties": {
    "ClusterName": {},
    "Type": {},
    "NodeName": {},
    "Sources": {},
    "Version": {},
    "cluster_failed_node_count": {},
    "cluster_node_count": {},
    "_aws": {
      "type": "object",
      "properties": {
        "CloudWatchMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Namespace": {},
              "Dimensions": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "Metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Name": {},
                    "Unit": {},
                    "StorageResolution": {}
                  },
                  "required": ["Name", "Unit", "StorageResolution"]
                }
              }
            },
            "required": ["Namespace", "Dimensions", "Metrics"]
          }
        },
        "Timestamp": {}
      },
      "required": [
        "CloudWatchMetrics",
        "Timestamp"
      ]
    }
  },
  "required": [
    "ClusterName",
    "Type",
    "NodeName",
    "Sources",
    "Version",
    "cluster_failed_node_count",
    "cluster_node_count",
    "_aws"
  ],
  "additionalProperties": false
}
