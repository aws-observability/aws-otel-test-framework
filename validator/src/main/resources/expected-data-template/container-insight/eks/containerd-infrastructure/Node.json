{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "structured log schema",
  "description": "json schema for the cloudwatch agent k8s structured log",
  "type": "object",

  "properties": {
    "ClusterName":{},
    "Type":{},
    "Sources":{},
    "Version":{},
    "AutoScalingGroupName":{},
    "InstanceId":{},
    "InstanceType":{},
    "NodeName":{},
    "node_cpu_limit":{},
    "node_memory_cache":{},
    "node_memory_failcnt":{},
    "node_memory_limit":{},
    "node_memory_mapped_file":{},
    "node_memory_max_usage":{},
    "node_memory_request":{},
    "node_memory_reserved_capacity":{},
    "node_memory_rss":{},
    "node_memory_swap":{},
    "node_memory_usage":{},
    "node_memory_utilization":{},
    "node_memory_working_set":{},
    "node_number_of_running_containers":{},
    "node_number_of_running_pods": {},
    "kubernetes": {
      "type": "object",
      "properties": {
        "host": {}
      },
      "required": ["host"],
      "additionalProperties": false
    },
    "_aws": {
      "type": "object",
      "properties": {
        "CloudWatchMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Namespace": {},
              "Dimensions": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "Metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Name": {},
                    "Unit": {},
                    "StorageResolution": {}
                  },
                  "required": ["Name", "Unit", "StorageResolution"]
                }
              }
            },
            "required": ["Namespace", "Dimensions", "Metrics"]
          }
        },
        "Timestamp": {}
      },
      "required": [
        "CloudWatchMetrics",
        "Timestamp"
      ]
    }
  },
  "required": [
    "ClusterName",
    "Type",
    "Sources",
    "Version",
    "AutoScalingGroupName",
    "InstanceId",
    "InstanceType",
    "NodeName",
    "kubernetes",
    "node_cpu_limit",
    "node_memory_cache",
    "node_memory_failcnt",
    "node_memory_limit",
    "node_memory_mapped_file",
    "node_memory_max_usage",
    "node_memory_request",
    "node_memory_reserved_capacity",
    "node_memory_rss",
    "node_memory_swap",
    "node_memory_usage",
    "node_memory_utilization",
    "node_memory_working_set",
    "node_number_of_running_containers",
    "node_number_of_running_pods",
    "_aws"
  ],
  "additionalProperties": false
}
