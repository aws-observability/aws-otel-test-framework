{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "structured log schema",
  "description": "json schema for the cloudwatch agent k8s structured log",
  "type": "object",

  "properties": {
    "kubernetes": {
      "type": "object",
      "properties": {
        "host": {}
      },
      "required": ["host"],
      "additionalProperties": false
    },
    "ClusterName": {},
    "Type": {},
    "Sources": {},
    "Version": {},
    "AutoScalingGroupName": {},
    "InstanceId": {},
    "InstanceType": {},
    "NodeName": {},
    "device": {},
    "fstype": {},
    "node_filesystem_available": {},
    "node_filesystem_capacity": {},
    "node_filesystem_usage": {},
    "node_filesystem_utilization":{},
    "node_filesystem_inodes_free": {},
    "node_filesystem_inodes": {},
    "_aws": {
      "type": "object",
      "properties": {
        "CloudWatchMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Namespace": {},
              "Dimensions": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "Metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Name": {},
                    "Unit": {},
                    "StorageResolution": {}
                  },
                  "required": ["Name", "Unit", "StorageResolution"]
                }
              }
            },
            "required": ["Namespace", "Dimensions", "Metrics"]
          }
        },
        "Timestamp": {}
      },
      "required": [
        "CloudWatchMetrics",
        "Timestamp"
      ]
    }
  },
  "required": [
    "_aws",
    "ClusterName",
    "Type",
    "Sources",
    "Version",
    "AutoScalingGroupName",
    "InstanceId",
    "InstanceType",
    "NodeName",
    "kubernetes",
    "device",
    "fstype",
    "node_filesystem_available",
    "node_filesystem_capacity",
    "node_filesystem_usage",
    "node_filesystem_utilization",
    "node_filesystem_inodes_free",
    "node_filesystem_inodes"
  ],
  "additionalProperties": false
}
